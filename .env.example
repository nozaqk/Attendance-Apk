# ---------------------------------------------------------------------------
# Public API base URL — the ONLY place the backend host is configured.
# Copy to .env.local (dev) or set it in your hosting provider (Vercel/Netlify).
# No trailing slash. Never put secrets in VITE_* variables: they are public.
# ---------------------------------------------------------------------------
# Custom domain behind Cloudflare:
VITE_API_URL=https://yourdomain.com

# Direct Render host (fallback / break-glass if Cloudflare is down):
# VITE_API_URL=https://attendance-system-33pl.onrender.com

# Legacy variable name — still read, prefer VITE_API_URL.
# VITE_API_BASE_URL=
