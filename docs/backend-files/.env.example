# Copy to .env for local work. NEVER commit a real .env. On Render set these in the dashboard.
# Neon connection string (use the pooled one) e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Optional: Neon's DIRECT (non-pooled) string, used only by `prisma migrate deploy` (pooled connections can break migrations)
DIRECT_URL=
# Long random string (>= 32 chars): openssl rand -base64 48
JWT_SECRET=
NODE_ENV=production
# Comma-separated browser origins of the four frontends. Bare origins only (no path, no trailing
# slash). Required in production - "*" is refused there. The Android app and the ESP32 nodes send
# no Origin header at all, so they keep working with an explicit list.
# e.g. https://student.attendance.example,https://lecturer.attendance.example,https://qa.attendance.example,https://admin.attendance.example
CORS_ORIGINS=
# How many proxies sit in front of the app. Render's edge = 1 (Cloudflare is handled by the header
# below). Set 0 to ignore X-Forwarded-For entirely.
TRUST_PROXY_HOPS=1
# Cloudflare puts the real client IP in CF-Connecting-IP; this makes rate limiting and the activity
# log see the browser instead of Cloudflare's edge. Leave true while the Render service is only
# reachable through Cloudflare; set false if you call Render directly.
TRUST_CF_CONNECTING_IP=true
# Requests per minute per client IP for the whole API (login/register/reset have their own limits).
RATE_LIMIT_MAX=300

# ---- optional ----
PORT=3000
JWT_EXPIRES_IN=12h
TZ_OFFSET_MINUTES=0            # Ghana = 0
EDIT_WINDOW_HOURS=6            # correction window after "class over"
LATE_AFTER_MINUTES=15
PENDING_CLASS_TTL_MINUTES=15   # a selected-but-not-started class frees its room after this
MAX_CLASS_HOURS=6              # forgotten classes are closed automatically
MIN_OBSERVATIONS=2
OBSERVATION_MIN_INTERVAL_SECONDS=30
REQUIRE_LECTURER_BLE=true

# Password-reset e-mail via the Resend HTTPS API (https://resend.com). Leave empty to disable e-mail.
BREVO_API_KEY
EMAIL_FROM=
PASSWORD_RESET_TTL_MINUTES=30
FRONTEND_URL_ADMIN=
FRONTEND_URL_QA=
FRONTEND_URL_LECTURER=
FRONTEND_URL_STUDENT=

# Dev only; the demo seed refuses to run in production
ALLOW_DEMO_SEED=false
# Only for tests: a throwaway Postgres database
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/attendance_test
