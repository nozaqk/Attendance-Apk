# Public API base URL (no trailing slash). Baked in at build time.
#
# TODO(domain migration): replace the legacy line below with your Cloudflare
# domain once it is live, and delete the legacy variable so the old host no
# longer ships in the bundle:
#
#   VITE_API_URL=https://yourdomain.com
#
# `VITE_API_URL` always wins over `VITE_API_BASE_URL`; until it is set, builds
# keep talking to the Render host. See docs/DOMAIN_AND_API_SECURITY.md.
VITE_API_BASE_URL=https://attendance-system-33pl.onrender.com
